# Private per-user records — never committed.
# Both patterns are needed: the trailing-slash form matches the real directory,
# the bare form matches the symlink used in the worktree setup (a symlink is not
# a directory to git, so the first pattern alone would let it be committed).
convos/*/private/
convos/*/private

scratch/

# Secrets
.env

# Python
.venv/
__pycache__/

# OS noise
.DS_Store


# LoRA adapter weights (127 MB each, over GitHub's limit); kept on the machine, released via Hugging Face
runs/lora/*/ckpt_*/adapter_model.safetensors
runs/hf_backup.log
runs/gpu_mem.log

# Step-19 release folder: weights stay local (cards are committed)
release/**/*.safetensors
